{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CProject",
  "version": "0.1.0",
  "identifier": "dev.cproject.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CProject", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 620 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* http://[::1]:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Calendar and project planning",
    "macOS": { "minimumSystemVersion": "14.4" },
    "windows": { "nsis": { "languages": ["English", "Japanese", "TradChinese"] } }
  },
  "plugins": { "sql": { "preload": ["sqlite:cproject.db"] } }
}
